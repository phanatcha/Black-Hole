// Per-pixel Kerr geodesic tracing. One thread per pixel, 8×8 groups.
#pragma kernel CSTraceDirections
#pragma kernel CSTrace
#pragma kernel CSShade
#pragma kernel CSMeasureExposure

#include "Geodesic.hlsl"
#include "Sky.hlsl"
#include "Stars.hlsl"
#include "Spectrum.hlsl"
#include "Exposure.hlsl"

// Camera tetrad in Kerr-Schild components, float4(x, y, z, t), built in double on the CPU.
float3 _CamPos;
float4 _CamU;
float4 _CamRight;
float4 _CamUp;
float4 _CamForward;
float _Spin;
float _TanHalfFovY;
float _Aspect;
float _FarRadius;
float _Tolerance;
int _MaxSteps;
int2 _Size;

RWStructuredBuffer<float4> _Directions;

// CSTrace to CSShade, two float4 per pixel: (world sky direction, g) then (disk radiance, transmittance).
// g is the sky's frequency shift, observed over emitted; 0 where the ray did not escape.
RWStructuredBuffer<float4> _Trace;
int _Blackout;
float4x4 _HoleToWorld;

// CSShade only.
RWTexture2D<float4> _Output;
TextureCube _Sky;
SamplerState sampler_Sky;
float _UseSky;
float _SkyLuminance;   // cd/m² of a sky texel valued 1

// Past-directed null covector for the pixel centre; matches RayTracer.TracePixel.
float4 PixelRay(uint2 id)
{
    float2 ndc = (float2(id) + 0.5) / float2(_Size) * 2.0 - 1.0;
    float3 d = normalize(float3(ndc.x * _TanHalfFovY * _Aspect, ndc.y * _TanHalfFovY, 1.0));
    float4 n = d.x * _CamRight + d.y * _CamUp + d.z * _CamForward;
    return KerrLower(n - _CamU, _CamPos, _Spin);
}

// Debug and test kernel: writes (sky direction, status) per pixel.
[numthreads(8, 8, 1)]
void CSTraceDirections(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= (uint2)_Size)) return;
    float3 skyDir, radiance;
    float transmittance;
    int status;
    TraceRay(_CamPos, PixelRay(id.xy), _Spin, _Tolerance, _FarRadius, _MaxSteps, skyDir, status, radiance, transmittance);
    _Directions[id.y * _Size.x + id.x] = float4(skyDir, status);
}

// The geodesic part of a frame: one ray per pixel, disk light composited along it, the sky direction it leaves by.
[numthreads(8, 8, 1)]
void CSTrace(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= (uint2)_Size)) return;
    float3 skyDir = 0.0, radiance = 0.0;
    float transmittance = 0.0, g = 0.0;
    if (_Blackout == 0)
    {
        int status;
        float4 k = PixelRay(id.xy);
        TraceRay(_CamPos, k, _Spin, _Tolerance, _FarRadius, _MaxSteps, skyDir, status, radiance, transmittance);
        if (status == KERR_STATUS_ESCAPED)
        {
            // k·u = 1 at the camera and k_t is conserved, so a source at rest far away sees the ray shifted by 1 / k_t.
            g = 1.0 / k.w;
            // Kerr-Schild (x, y, z) is hole-local (x, z, y); the matrix may carry scale, so renormalize.
            skyDir = normalize(mul((float3x3)_HoleToWorld, skyDir.xzy));
        }
        else skyDir = 0.0;
    }
    uint i = id.y * _Size.x + id.x;
    _Trace[2 * i] = float4(skyDir, g);
    _Trace[2 * i + 1] = float4(radiance, transmittance);
}

// Sky direction through pixel p, or 0 where its ray did not escape or p is off screen.
float3 KerrSkyDirection(int2 p)
{
    if (any(p < 0) || any(p >= _Size)) return 0.0;
    float4 s = _Trace[2 * (p.y * _Size.x + p.x)];
    return s.w > 0.0 ? s.xyz : 0.0;
}

// Mirror of Footprint.Step: the central difference where the one-sided steps differ by at most two thirds of their
// mean, else the smaller one-sided step; tangent to the centre direction.
bool KerrFootprintStep(float3 centre, float3 back, float3 forward, out float3 step)
{
    bool hasBack = dot(back, back) > 0.0, hasForward = dot(forward, forward) > 0.0;
    float3 b = centre - back, f = forward - centre, sum = f + b, gap = f - b;
    step = !hasBack ? f : (!hasForward ? b
         : (9.0 * dot(gap, gap) <= dot(sum, sum) ? 0.5 * sum : (dot(f, f) <= dot(b, b) ? f : b)));
    step -= centre * dot(centre, step);
    return hasBack || hasForward;
}

// Mirror of Footprint.Estimate: change of sky direction per pixel step in x and y.
void KerrFootprint(int2 p, float3 centre, out float3 jx, out float3 jy)
{
    bool hasX = KerrFootprintStep(centre, KerrSkyDirection(p - int2(1, 0)), KerrSkyDirection(p + int2(1, 0)), jx);
    bool hasY = KerrFootprintStep(centre, KerrSkyDirection(p - int2(0, 1)), KerrSkyDirection(p + int2(0, 1)), jy);
    float pixel = 2.0 * _TanHalfFovY / _Size.y;
    if (!hasX) jx = normalize(hasY ? cross(jy, centre) : cross(centre, abs(centre.y) < 0.9 ? float3(0, 1, 0) : float3(1, 0, 0))) * pixel;
    if (!hasY) jy = normalize(cross(centre, jx)) * pixel;
}

// Lensed frame from the trace: disk light in front of the sky and stars, both filtered over the pixel's footprint and
// shifted by the ray's g. Output is scene luminance times last frame's exposure, clamped below the RGBA16F maximum so
// bloom never sees infinity; each 4th pixel's unexposed luminance also goes to the meter.
[numthreads(8, 8, 1)]
void CSShade(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= (uint2)_Size)) return;
    uint i = id.y * _Size.x + id.x;
    float4 sky = _Trace[2 * i], disk = _Trace[2 * i + 1];
    float3 color = disk.rgb;
    if (sky.w > 0.0)
    {
        float3 jx, jy;
        KerrFootprint(int2(id.xy), sky.xyz, jx, jy);
        float3 background = _UseSky > 0.5 ? _Sky.SampleGrad(sampler_Sky, sky.xyz, jx, jy).rgb : KerrGridSky(sky.xyz);
        color += disk.a * (_SkyLuminance * KerrShiftRgb(background, sky.w) + KerrStarRadiance(sky.xyz, jx, jy, sky.w));
    }
    if (all(id.xy % KERR_METER_STRIDE == 0))
    {
        uint meterWidth = (_Size.x + KERR_METER_STRIDE - 1) / KERR_METER_STRIDE;
        _MeterSamples[(id.y / KERR_METER_STRIDE) * meterWidth + id.x / KERR_METER_STRIDE] = KerrLuminance(color);
    }
    _Output[id.xy] = float4(min(color * KerrExposure(), 65000.0), 1.0);
}

// Eye adaptation from this frame's meter samples into the EV100 state the next frame is exposed with. One group.
[numthreads(KERR_METER_THREADS, 1, 1)]
void CSMeasureExposure(uint3 tid : SV_GroupThreadID)
{
    KerrMeasureExposure(tid.x);
}
